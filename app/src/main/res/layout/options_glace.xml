<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantité de glaçons"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/radioGlacons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peu"/>

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normale"
            android:checked="true"/>

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beaucoup"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sirop"
        android:textStyle="bold"/>

    <CheckBox
        android:id="@+id/chkSiropVanille"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vanille"/>

    <CheckBox
        android:id="@+id/chkSiropCaramel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caramel"/>

    <CheckBox
        android:id="@+id/chkSiropNoisette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noisette"/>

    <CheckBox
        android:id="@+id/chkChantilly"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ajouter chantilly"/>

</LinearLayout>
  