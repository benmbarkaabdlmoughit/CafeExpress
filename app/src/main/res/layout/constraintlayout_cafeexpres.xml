<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.projet2kotlinlayoute.MainActivity">

    <TextView
        android:id="@+id/titrecafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cafe Express"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">
    </TextView>
    <TextView
        android:id="@+id/prsiscmd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prise de commande"
        android:textColor="#808080"
        app:layout_constraintTop_toBottomOf="@id/titrecafe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </TextView>



    <TextView
        android:id="@+id/Cafe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:text="Cafe"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/prsiscmd"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp">
    </TextView>
    <TextView
        android:id="@+id/prix10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_bias="1"
        android:text="10 DH"
        android:textColor="#808080"
        app:layout_constraintStart_toEndOf="@id/Cafe"
        app:layout_constraintTop_toBottomOf="@id/prsiscmd"
        android:layout_marginStart="90dp"
        app:layout_constraintBaseline_toBaselineOf="@id/Cafe">
    </TextView>
    <ImageButton
        android:id="@+id/btn1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/prix10"
        app:layout_constraintTop_toBottomOf="@id/prsiscmd"
        android:layout_marginTop="40dp"
        android:layout_marginStart="30dp" />
    <TextView
        android:id="@+id/quntite1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:hint="0"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toEndOf="@id/btn1"
        app:layout_constraintBottom_toBottomOf="@id/Cafe"
        app:layout_constraintBaseline_toBaselineOf="@id/Cafe">
    </TextView>
    <ImageButton
        android:id="@+id/btn2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_arrow_forward_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/quntite1"
        app:layout_constraintTop_toBottomOf="@id/prsiscmd"
        android:layout_marginTop="40dp"
        android:layout_marginStart="30dp">
    </ImageButton>





//the
    <TextView
        android:id="@+id/The"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:text="The"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/Cafe"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp">
    </TextView>
    <TextView
        android:id="@+id/prix8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_bias="1"
        android:text="8 DH"
        android:textColor="#808080"
        app:layout_constraintStart_toEndOf="@id/The"
        app:layout_constraintTop_toBottomOf="@id/prix10"
        android:layout_marginStart="95dp"
        app:layout_constraintBaseline_toBaselineOf="@id/The">
    </TextView>
    <ImageButton
        android:id="@+id/btn3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/prix8"
        app:layout_constraintTop_toBottomOf="@id/btn1"
        android:layout_marginTop="37dp"
        android:layout_marginStart="38dp" />
    <TextView
        android:id="@+id/quntite2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:hint="0"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toEndOf="@id/btn3"
        app:layout_constraintTop_toBottomOf="@id/quntite1"
        app:layout_constraintBaseline_toBaselineOf="@id/The">
    </TextView>
    <ImageButton
        android:id="@+id/btn4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_arrow_forward_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/quntite2"
        app:layout_constraintTop_toBottomOf="@id/btn2"
        android:layout_marginTop="37dp"
        android:layout_marginStart="30dp">
    </ImageButton>


    //Croissant
    <TextView
        android:id="@+id/croissent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:text="Croissant"
        android:textStyle="bold"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/The"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp">
    </TextView>
    <TextView
        android:id="@+id/prix6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_bias="1"
        android:text="8 DH"
        android:textColor="#808080"
        app:layout_constraintStart_toEndOf="@id/croissent"
        app:layout_constraintTop_toBottomOf="@id/prix8"
        android:layout_marginStart="44dp"
        app:layout_constraintBaseline_toBaselineOf="@id/croissent">
    </TextView>
    <ImageButton
        android:id="@+id/btn5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_arrow_back_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/prix6"
        app:layout_constraintTop_toBottomOf="@id/btn3"
        android:layout_marginTop="34dp"
        android:layout_marginStart="37dp" />
    <TextView
        android:id="@+id/quntite3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintHorizontal_weight="1"
        android:hint="0"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toEndOf="@id/btn5"
        app:layout_constraintTop_toBottomOf="@id/quntite2"
        app:layout_constraintBaseline_toBaselineOf="@id/croissent">
    </TextView>
    <ImageButton
        android:id="@+id/btn6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/outline_arrow_forward_24"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/quntite3"
        app:layout_constraintTop_toBottomOf="@id/btn4"
        android:layout_marginTop="34dp"
        android:layout_marginStart="30dp">
    </ImageButton>


    <TextView
        android:id="@+id/Nonclient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOM du client"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/croissent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginStart="10dp">
    </TextView>
    <EditText
        android:id="@+id/editnom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Votre nom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Nonclient"
        app:layout_constraintEnd_toEndOf="parent">
    </EditText>
    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total :"
        android:textStyle="bold"
        android:textSize="25dp"
        app:layout_constraintTop_toBottomOf="@id/editnom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">
    </TextView>
    <Button
        android:id="@+id/btnvider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Vider"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintEnd_toStartOf="@id/btncommander"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </Button>
    <Button
        android:id="@+id/btncommander"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Commander"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@id/btnvider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </Button>






</androidx.constraintlayout.widget.ConstraintLayout>