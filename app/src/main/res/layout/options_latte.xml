<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Type de lait"
        android:textStyle="bold"/>

    <RadioGroup
        android:id="@+id/radioTypeLait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entier"
            android:checked="true"/>

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Amande"/>

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avoine"/>

        <RadioButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Soja"/>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sirop"
        android:textStyle="bold"/>

    <CheckBox
        android:id="@+id/chkVanille"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vanille"/>

    <CheckBox
        android:id="@+id/chkCaramel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Caramel"/>

    <CheckBox
        android:id="@+id/chkNoisette"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noisette"/>

</LinearLayout>
  